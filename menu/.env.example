# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun.
# Node.js 20.12+ sürümlerinde menu/.env otomatik okunur.

# Yönetici paneli şifresi. Boş bırakılırsa geliştirme şifresi kullanılır (yayında kullanmayın).
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yazin

# Sunucunun dinleyeceği port.
PORT=3000

# QR kodun göstereceği menü adresi. Boş bırakılırsa tarayıcıdaki adres kullanılır.
# Örnek: https://menu.restoraniniz.com
PUBLIC_URL=

# Sunucu bir ters vekil (nginx, Caddy, Cloudflare vb.) arkasındaysa 1 yapın.
# Böylece HTTPS ve ziyaretçi IP adresi doğru algılanır.
TRUST_PROXY=0
